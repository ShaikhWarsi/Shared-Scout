# ==============================================================================
# AgentScout Environment Configuration
# ==============================================================================
# All variables have safe production defaults. AgentScout runs out-of-the-box
# without any mandatory external API keys or cloud tokens.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gateway & Server Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
SHAREDOS_NODE_ID=agentscout.sharedos.net

# ------------------------------------------------------------------------------
# 2. SharedOS & Cryptographic Authentication
# ------------------------------------------------------------------------------
# Secret key used for HMAC-SHA256 turn authorization
SHAREDOS_SECRET_KEY=sharedos_production_secret_key_v1

# Whether to enforce HMAC-SHA256 signatures on incoming A2A calls (true/false)
SHAREDOS_ENFORCE_HMAC=true

# Known seed peer nodes for federation routing
SHAREDOS_SEED_NODES=http://localhost:8001,http://localhost:8002

# Optional production Ed25519 keypair (PEM format).
# If omitted, AgentScout automatically generates and persists a local keypair in .sharedos/ed25519_keys.json
# AGENTSCOUT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AGENTSCOUT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ------------------------------------------------------------------------------
# 3. Optional LLM Inference (Deterministic NLI regex is primary fallback)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# ------------------------------------------------------------------------------
# 4. SharedNet Arena Runtime (Supplied automatically by SharedNet CLI)
# ------------------------------------------------------------------------------
# SHAREDNET_SEAT=i_...
# SHAREDNET_ROOM_ID=rom_...
